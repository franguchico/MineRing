{
	"schemaVersion": 1,
	"id": "erbridge",
	"version": "${version}",
	"name": "ER Bridge (Experimental)",
	"description": "Experimental passthrough bridge that runs Minecraft inside Elden Ring, with native Windows and macOS/CrossOver support.",
	"authors": ["justbustin"],
	"license": "MIT",
	"icon": "assets/erbridge/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.ermc.bridge.ErBridgeMod"],
		"client": ["dev.ermc.bridge.client.ErBridgeClient"]
	},
	"mixins": [
		"erbridge.mixins.json",
		{
			"config": "erbridge.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
